{
  "name": "lab7-scss",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:dev": "sass src/scss/main.scss css/style.css --style=expanded --source-map",
    "watch": "sass --watch src/scss/main.scss:css/style.css --style=expanded --source-map",
    "build": "sass src/scss/main.scss css/style.min.css --style=compressed --no-source-map"
  },
  "devDependencies": { "sass": "^1.80.0" }
}
